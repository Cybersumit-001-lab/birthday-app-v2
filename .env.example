# SMTP Settings (for sending from r.sumit@itorizin.in)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nsoc@itorizin.in
SMTP_PASS=your-email-password-or-app-password

# From address (must match SMTP_USER or be allowed by your mail server)
EMAIL_FROM=nsoc@itorizin.in

# Secret to protect the daily birthday job
CRON_SECRET=mybirthdaysecret2026

# JWT secret for admin session tokens (change this to something random and long!)
JWT_SECRET=change-me-to-a-long-random-string
